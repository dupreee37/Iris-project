# demo = sin llamadas pagas; live = proveedores reales
IRIS_MODE=demo
OPENAI_API_KEY=
GEMINI_API_KEY=
XAI_API_KEY=

# Cerebro con Claude (python -m iris --claude). Clave de la consola de Anthropic
# (console.anthropic.com), no la del plan de claude.ai. Nunca la subas al repo.
ANTHROPIC_API_KEY=
# Voz y oído de --claude. auto = lo mejor que permitan las claves de arriba:
#   voz: ElevenLabs (clave + voz) > OpenAI > Windows; oído: ElevenLabs Scribe > OpenAI > Vosk local.
# Forzá gratis con IRIS_TTS=windows e IRIS_STT=vosk. Con claves, lo que decís viaja a esos servicios.
IRIS_TTS=auto
IRIS_STT=auto
# Oído con ElevenLabs Scribe: términos a favorecer y confianza mínima (más bajo = descarta menos).
IRIS_STT_KEYTERMS=["Iris"]
IRIS_STT_MIN_LOGPROB=-2.0
# Silencio (segundos) que cierra una frase. Subilo si todavía te corta; bajalo para responder antes.
IRIS_STT_HANGOVER_SECONDS=0.5
# Segundos sin hablar tras los cuales hay que volver a decir «Iris».
IRIS_AWAKE_SECONDS=60
# Cortar a IRIS cuando le hablás encima. Con parlantes (sin auriculares) puede cortarse sola: poné false.
IRIS_BARGE_IN=true
ELEVENLABS_API_KEY=
IRIS_ELEVENLABS_VOICE_ID=
IRIS_ELEVENLABS_MODEL=eleven_flash_v2_5
IRIS_OPENAI_TTS_MODEL=gpt-4o-mini-tts
IRIS_OPENAI_TTS_VOICE=marin

# Sonnet 5.5 cuesta la mitad que claude-opus-5-5 y responde más rápido para voz.
IRIS_CLAUDE_MODEL=claude-sonnet-5-5
IRIS_CLAUDE_EFFORT=low
IRIS_CLAUDE_MAX_TURNS=8
IRIS_CLAUDE_FALLBACKS=true
IRIS_CLAUDE_WEB=true
# natural = abre lo que le pedís sin frase especial; strict = espera un «sí/dale» en el turno siguiente.
IRIS_CONFIRM_ACTIONS=natural
# Muletillas («mmm», «a ver…») mientras piensa.
IRIS_FILLERS=true
# Apps que IRIS puede abrir. JSON: nombre hablado -> ejecutable.
IRIS_ALLOWED_APPS={"bloc de notas":"notepad.exe","calculadora":"calc.exe","explorador":"explorer.exe"}

# Roles independientes. Verificar acceso a estos modelos en cada cuenta.
IRIS_VOICE_MODEL=gpt-realtime-2.1
IRIS_VOICE_REASONING=low
IRIS_VAD_EAGERNESS=medium
IRIS_TRANSCRIPTION_MODEL=gpt-transcribe
IRIS_REASON_MODEL=gpt-5.6-terra
IRIS_RESEARCH_PROVIDER=gemini
IRIS_GEMINI_MODEL=gemini-3.8-flash
IRIS_XAI_MODEL=grok-4.7
IRIS_TOOL_TIMEOUT_SECONDS=45
IRIS_MAX_ACTIVE_JOBS=4
