# demo = sin llamadas pagas; live = proveedores reales
IRIS_MODE=demo
OPENAI_API_KEY=
GEMINI_API_KEY=
XAI_API_KEY=

# Roles independientes. Verificar acceso a estos modelos en cada cuenta.
IRIS_VOICE_MODEL=gpt-realtime-2.1
IRIS_VOICE_REASONING=low
IRIS_VAD_EAGERNESS=medium
IRIS_TRANSCRIPTION_MODEL=gpt-transcribe
IRIS_REASON_MODEL=gpt-5.6-terra
IRIS_RESEARCH_PROVIDER=gemini
IRIS_GEMINI_MODEL=gemini-3.8-flash
IRIS_XAI_MODEL=grok-4.7
IRIS_TOOL_TIMEOUT_SECONDS=45
IRIS_MAX_ACTIVE_JOBS=4
